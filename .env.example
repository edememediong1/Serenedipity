# ---------------------------------------------------------------------------
# Serenedipity environment variables. Copy to .env.local and fill in.
# Never commit real values. NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for metadata, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API).
# Local dev: run `pnpm db:start` and copy API_URL / PUBLISHABLE_KEY from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Used by the admin dashboard and the Stripe webhook (and by e2e tests).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Salt for hashing IP addresses in the waitlist rate limiter. Any long random string.
RATE_LIMIT_SALT=

# Luna, the AI focus guide (server-only keys; never prefix with NEXT_PUBLIC_).
# Claude API key from https://platform.claude.com, used for check-ins and plans.
ANTHROPIC_API_KEY=
# Deepgram key for transcribing voice notes. Without it, check-ins are typed only.
DEEPGRAM_API_KEY=
# Optional Deepgram model override (default nova-3).
DEEPGRAM_MODEL=
# Development and tests only: "true" makes Luna reply with canned, deterministic responses
# instead of calling Claude. Ignored in production.
LUNA_MOCK=false

# Admins: comma-separated emails that always have admin access (/admin), in addition to
# anyone with profiles.role = 'admin'. Admins are never limited by daily check-in caps.
ADMIN_EMAILS=

# Stripe (Pro plan). Dashboard > Developers > API keys and Webhooks; Products > prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Auth provider switches. Google is on unless set to "false".
# Apple stays off until credentials exist; set to "true" to show the button.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false

# Local Supabase only: Google OAuth credentials picked up by supabase/config.toml.
# In production these go in Supabase Dashboard > Authentication > Providers > Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
