# ---------------------------------------------------------------------------
# Serenedipity environment variables. Copy to .env.local and fill in.
# Never commit real values. NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for metadata, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API).
# Local dev: run `pnpm db:start` and copy API_URL / PUBLISHABLE_KEY from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://piskfoxoeevycfzhpcdn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. NOT used by the app at runtime; only by e2e tests
# (to create test users and magic links). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Salt for hashing IP addresses in the waitlist rate limiter. Any long random string.
RATE_LIMIT_SALT=

# Auth provider switches. Google is on unless set to "false".
# Apple stays off until credentials exist; set to "true" to show the button.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false

# Local Supabase only: Google OAuth credentials picked up by supabase/config.toml.
# In production these go in Supabase Dashboard > Authentication > Providers > Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
